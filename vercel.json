{
  "redirects": [
    { "source": "/hello-world", "destination": "/blog", "permanent": true },
    { "source": "/hello-world/", "destination": "/blog", "permanent": true },
    { "source": "/domande-e-risposte", "destination": "/blog", "permanent": true },
    { "source": "/domande-e-risposte/", "destination": "/blog", "permanent": true },
    { "source": "/elementor-hf/:path*", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!assets|blog-covers|favicon|og-image|apple-touch-icon|manifest|sitemap|robots|llms).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
